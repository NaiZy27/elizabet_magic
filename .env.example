# Шаблон окружения. Скопировать в .env и заполнить.
# .env в репозиторий не коммитится (см. .gitignore).

# --- общее ---
TZ=Europe/Moscow
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://em:changeme@postgres:5432/elizabet_magic
REDIS_URL=redis://redis:6379
PUBLIC_BASE_URL=https://example.ru
ADMIN_BASE_URL=https://crm.example.ru
# Контур служб доставки: test или production
DELIVERY_ENVIRONMENT=test
# Приём денег: stub — заглушка (кнопка «оплачено» без списания, только для тестов),
# robokassa — настоящая оплата. Для robokassa нужны ключи ниже.
PAYMENTS_MODE=stub

# Только на сервере: не подхватывать docker-compose.override.yml, он для разработки.
# COMPOSE_FILE=docker-compose.yml

# Пароль для контейнера postgres (docker-compose)
POSTGRES_USER=em
POSTGRES_PASSWORD=changeme
POSTGRES_DB=elizabet_magic

# --- бот ---
BOT_TOKEN=
BOT_USERNAME=                 # имя бота без @, для ссылки возврата со страницы оплаты
# Кому приходят уведомления о заказах. Этот аккаунт видит в боте рабочее меню
# (фото боксов, ссылка на панель) вместо клиентского и не может оформлять заказы.
OWNER_CHAT_ID=
# Необязательно: чат, через который панель загружает фото боксов. В боте фото
# можно прислать напрямую, тогда служебный чат не нужен. Тоже рабочий аккаунт.
SERVICE_CHAT_ID=

# --- админка ---
ADMIN_SESSION_SECRET=
ADMIN_HTTPS_ONLY=true

# --- Робокасса ---
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_HASH_ALGO=md5
ROBOKASSA_IS_TEST=true

# --- СДЭК ---
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_BASE_URL=https://api.edu.cdek.ru/v2
CDEK_SHIPMENT_POINT=
CDEK_TARIFF_CODE=

# --- Яндекс Доставка ---
YANDEX_DELIVERY_TOKEN=
YANDEX_DELIVERY_BASE_URL=https://b2b.taxi.tst.yandex.net
YANDEX_DROPOFF_STATION_ID=

# --- бэкапы ---
# Куда слать копию базы. По умолчанию — SERVICE_CHAT_ID, иначе OWNER_CHAT_ID.
# 0 — не отправлять, копия останется только на диске сервера.
BACKUP_CHAT_ID=
# Если задать, дамп уедет зашифрованным (в нём телефоны и email покупателей).
# Пароль храните отдельно от сервера — без него копия бесполезна.
BACKUP_PASSPHRASE=

# --- бизнес ---
UNPAID_ORDER_TTL_MIN=60
